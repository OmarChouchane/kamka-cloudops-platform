# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — never commit real values.

project_name      = "kamka"
environment       = "dev"
region            = "eu-west-1"

# Ubuntu 22.04 LTS (Jammy) — eu-west-1 — updated 2024
# Find latest: aws ec2 describe-images --owners 099720109477 \
#   --filters "Name=name,Values=ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*" \
#   --query 'sort_by(Images,&CreationDate)[-1].ImageId' --region eu-west-1
ami_id            = "ami-0694d931cee176e7d"

instance_type     = "t3.micro"   # free-tier eligible
key_name          = "kamka-dev-key"

# Restrict SSH to your own IP for security
# Run: curl -s ifconfig.me to get your IP
allowed_ssh_cidr  = "YOUR_IP/32"

vpc_cidr          = "10.0.0.0/16"
subnet_cidr       = "10.0.1.0/24"
availability_zone = "eu-west-1a"
