# Caddyfile
# Set DOMAIN env var to your domain for automatic HTTPS (Let's Encrypt).
# Without a domain, defaults to :80 (HTTP only — for local testing).

{$DOMAIN:localhost} {

    # API routes — strip /api prefix before proxying to backend
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # Direct health check passthrough
    handle /healthz {
        reverse_proxy api:3000
    }

    # All other traffic goes to the frontend
    handle {
        reverse_proxy frontend:3000
    }
}
