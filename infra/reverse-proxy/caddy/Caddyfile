# Caddyfile
# Set DOMAIN env var to your domain for automatic HTTPS (Let's Encrypt).
# Without a domain, defaults to :80 (HTTP only — for local testing).

http://{$DOMAIN:localhost} {

    # API routes
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3000
    }

    # Direct API endpoints (frontend calls these without /api prefix)
    handle /users* {
        reverse_proxy api:3000
    }

    # Health check
    handle /healthz {
        reverse_proxy api:3000
    }

    handle /grafana* {
        reverse_proxy grafana:3000
    }


    # All other traffic goes to the frontend
    handle {
        reverse_proxy frontend:3000
    }
}
