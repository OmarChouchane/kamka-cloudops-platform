# PostgreSQL — main database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monorepodb

# Backend API
NODE_ENV=development
DB_HOST=postgres
DB_DATABASE=monorepodb
DB_USER=monorepo_user
DB_PASSWORD=monorepo-password
DB_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Test database (used by api-test service only)
TEST_DB_HOST=postgres-test
TEST_DB_DATABASE=postgres
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_PORT=5431
